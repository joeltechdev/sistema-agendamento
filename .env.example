# Configurações do Supabase (Valores de Exemplo)
NEXT_PUBLIC_SUPABASE_URL=https://exemplo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Configurações de Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/meu_banco

# URL Base da Aplicação (usada na geração dos links de e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo de Assinatura da Sessão JWT (mínimo 32 caracteres)
SESSION_SECRET=troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres

# ==============================================================================
# Configuração de Envio de E-mails via Google (Gmail SMTP)
# ==============================================================================
# 1. Ative a "Verificação em 2 etapas" na sua Conta Google.
# 2. Acesse https://myaccount.google.com/apppasswords
# 3. Crie uma "Senha de App" chamada "Agendamento Poranga" e copie os 16 caracteres.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-de-16-letras
SMTP_FROM="Identificação Civil - Poranga <seu-email@gmail.com>"
